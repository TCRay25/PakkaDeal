PORT=8000
DATABASE_URL=postgresql://postgres:password@localhost:5432/pakkadeal
USE_SQLITE=true
SECRET_KEY=pakkadeal-super-secret-key-prod-2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_OTP=123456
ADMIN_PHONES=01700000000,01711111111
WEBHOOK_KEY=demo-webhook-key
SHIP_WITHIN_HOURS=48
CONFIRM_WITHIN_HOURS=72
FEE_PERCENT=2
FEE_MIN=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SMS Gateway for real SMS delivery to mobile phones
# Option A: Greenweb BD (https://greenweb.com.bd)
GREENWEB_TOKEN=
# Option B: BulkSMS BD (https://bulksmsbd.net)
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Option C: Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Admin SDK Configuration (Option 1: JSON file path, Option 2: JSON string or base64)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Or inline JSON / base64:
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=your-firebase-project-id

# Courier Tracking API Credentials (Production)
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
PATHAO_API_TOKEN=your_pathao_bearer_token
REDX_API_TOKEN=your_redx_bearer_token
PAPERFLY_USERNAME=your_paperfly_username
PAPERFLY_PASSWORD=your_paperfly_password
ECOURIER_API_KEY=your_ecourier_api_key
